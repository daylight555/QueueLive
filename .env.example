# Copy to .env, then replace both passwords. Never commit .env.
DATABASE_PASSWORD=replace-with-local-database-password
DEMO_ENABLED=true
DEMO_STAFF_PASSWORD=replace-with-at-least-12-characters
# LAN demos: use your computer's reachable LAN IP, not localhost.
PUBLIC_BASE_URL=http://localhost:8080
# false is ONLY for local HTTP. Production HTTPS must use true.
COOKIE_SECURE=false
